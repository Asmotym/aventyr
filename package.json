{
  "name": "aventyr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "server:dev": "tsx server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "server:test": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test server/tests/*.test.ts src/tests/*.test.ts",
    "server:test:awards": "ROLL_AWARDS_INTEGRATION=1 TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test server/tests/session-awards.integration.test.ts",
    "server:build": "npm run server:typecheck && tsup --config tsup.config.ts",
    "server:start": "node dist-server/index.js",
    "server:sentry-check": "node dist-server/verify-sentry.js",
    "db:update": "tsx server/scripts/update-schema.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@sentry/node": "^10.26.0",
    "@types/sanitize-html": "^2.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "mysql2": "^3.12.0",
    "pinia": "^3.0.3",
    "sanitize-html": "^2.13.1",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.10",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@sentry/esbuild-plugin": "^5.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "sass-embedded": "^1.89.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.12"
  }
}
