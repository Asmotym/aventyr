# Minimal configuration
VITE_BACKEND_URL=http://localhost:4000
VITE_PUBLIC_API_BASE_URL=http://localhost:4000/api
VITE_API_DOCS_URL=http://localhost:6060
API_DOCS_BASE_URL=http://localhost:4000/api
API_DOCS_HOST_PORT=6060
ENVIRONMENT=development
AVENTYR_DEV_MODE=true
LE_EMAIL=

# Backend server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Docker defaults)
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=
DATABASE_URL=
DATABASE_SSL=false

# Discord
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults to VITE_DISCORD_REDIRECT_URI when omitted.
DISCORD_REDIRECT_URI=http://localhost:5173
OWNER_DISCORD_USER_ID=

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
# Git-ignored build-only secret file; alternatively export SENTRY_AUTH_TOKEN from a secret manager.
SENTRY_AUTH_TOKEN_FILE=.secrets/sentry-auth-token
# Defaults to 0.1 in production and 1.0 in development.
SENTRY_TRACES_SAMPLE_RATE=