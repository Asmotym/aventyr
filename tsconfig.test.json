{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"],
      "assets/*": ["src/assets/*"]
    },
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  }
}
